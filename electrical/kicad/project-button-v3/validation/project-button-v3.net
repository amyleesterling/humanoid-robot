	(components
		(comp
			(ref "JA1")
			(value "Molex 39012066 housing; 6x 444783112 HCS male contacts; 16 AWG")
			(datasheet "https://www.molex.com/en-us/products/part-detail/39012066")
			(description "Mates the source's 39-01-2060-equivalent receptacle. Use six individual 16 AWG copper conductors, one per contact, and Molex tool 63819-0900. Pins 1-3 are +12 V and 4-6 are bonded 0 V. Do not hot-plug or use current sharing as a safety assumption.")
			(fields
				(field
					(name "Status") "PROPOSED - CONNECTOR SYSTEM FROZEN; HARNESS/THERMAL VERIFICATION REQUIRED")
				(field
					(name "Evidence") "Molex 5559 and 44478 series data accessed 2026-08-06; PS-44476-001 rev D dated 2003-06-12; ATS-638190900 rev H dated 2015-08-28. Six-contact 16 AWG HCS project-side screen is 21 A / 3 = 7 A per contact versus the published 11 A HCS guideline. The adapter-side contact construction and real current division are not published, so received-harness thermal, crimp and current-division tests remain mandatory.")
				(field
					(name "Display") "Molex 39012066 housing; 6x 444783112 HCS male contacts; 16 AWG")
				(field
					(name "Footprint")
				)
				(field
