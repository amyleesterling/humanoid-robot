      (property "Value" "GlobTek WR9QI1660YL4NKITR6B, 24 V 1.66 A 40 W, YL4/C40337 factory 4-pin locking cord" (at 100.33 139.70 0) (effects (font (size 1.50 1.50)) (hide yes)))
      (property "Footprint" "" (at 100.33 139.70 0) (effects (font (size 1.50 1.50)) (hide yes)))
      (property "Datasheet" "https://www.globtek.com/_0/WR9QI1660YL4NKITR6B/o" (at 100.33 139.70 0) (effects (font (size 1.50 1.50)) (hide yes)))
      (property "Description" "Factory-sealed Class II wall adapter with floating output and included interchangeable Q blade kit. Rev B specifies a 1200 mm UL 1185 16 AWG 1C-plus-shield output cord, YL4 four-pin locking plug, pin 1 +24 V, pin 3 return/shield, and pins 2/4 N/C. Output current limit is 110-160% with auto-recovery; full rated load is specified only through 40 C ambient and derates to 80% at 50 C. Do not connect until received identity, blade retention, plug identity, polarity, load/startup, abnormal-condition and site-use evidence are accepted." (at 100.33 139.70 0) (effects (font (size 1.50 1.50)) (hide yes)))
      (property "Status" "EXACT SOURCE/OUTPUT-CORD CANDIDATE - RECEIVED AND APPLICATION VERIFICATION REQUIRED" (at 100.33 155.40 0) (effects (font (size 1.50 1.50)) (justify bottom)))
