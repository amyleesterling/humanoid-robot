      (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no)
      (uuid "c0602603-8693-58a8-be61-435992901612")
      (property "Reference" "JA1" (at 285.75 37.91 0) (effects (font (size 1.50 1.50)) (justify left bottom)))
      (property "Value" "Molex 39012066 housing; 6x 444783112 HCS male contacts; 16 AWG" (at 325.12 59.69 0) (effects (font (size 1.50 1.50)) (hide yes)))
      (property "Footprint" "" (at 325.12 59.69 0) (effects (font (size 1.50 1.50)) (hide yes)))
      (property "Datasheet" "https://www.molex.com/en-us/products/part-detail/39012066" (at 325.12 59.69 0) (effects (font (size 1.50 1.50)) (hide yes)))
      (property "Description" "Mates the source's 39-01-2060-equivalent receptacle. Use six individual 16 AWG copper conductors, one per contact, and Molex tool 63819-0900. Pins 1-3 are +12 V and 4-6 are bonded 0 V. Do not hot-plug or use current sharing as a safety assumption." (at 325.12 59.69 0) (effects (font (size 1.50 1.50)) (hide yes)))
      (property "Status" "PROPOSED - CONNECTOR SYSTEM FROZEN; HARNESS/THERMAL VERIFICATION REQUIRED" (at 325.12 80.47 0) (effects (font (size 1.50 1.50)) (justify bottom)))
      (property "Evidence" "Molex 5559 and 44478 series data accessed 2026-08-06; PS-44476-001 rev D dated 2003-06-12; ATS-638190900 rev H dated 2015-08-28. Six-contact 16 AWG HCS project-side screen is 21 A / 3 = 7 A per contact versus the published 11 A HCS guideline. The adapter-side contact construction and real current division are not published, so received-harness thermal, crimp and current-division tests remain mandatory." (at 325.12 59.69 0) (effects (font (size 1.50 1.50)) (hide yes)))
      (property "Display" "Molex 39012066 housing; 6x 444783112 HCS male contacts; 16 AWG" (at 285.75 41.11 0) (effects (font (size 1.50 1.50)) (justify left bottom)))
      (pin "1" (uuid "244c493b-4522-5230-ac38-e5a34424a423"))
